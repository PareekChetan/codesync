# Copy to .env and adjust. Every value has a sensible local default.
PORT=4000
DATABASE_URL=postgres://codesync:codesync@localhost:5432/codesync
REDIS_URL=redis://localhost:6379
# Use a long random string in production:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-please
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
PERSIST_DEBOUNCE_MS=2000
PERSIST_MAX_WAIT_MS=10000
MAX_CLIENTS_PER_ROOM=50
LOG_LEVEL=info
# Code runner (start it with: cd ../runner && npm start)
RUNNER_URL=http://localhost:5050
RUNNER_TOKEN=
RUNS_PER_MINUTE=20
